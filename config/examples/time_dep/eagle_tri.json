{
    "setup": {
        "seed": 1,
        "device": "cuda:0",
        "dtype": "torch.float32",
        "trainer_name": "sequential",
        "train": true,
        "test": true,
        "ckpt": false
    },

    "model": {
        "name": "gaot",
        "latent_tokens_size": [32, 32],
        "args": {
            "magno": {
                "coord_dim": 2,
                "radius": 0.15,
                "hidden_size": 64,
                "mlp_layers": 3,
                "lifting_channels": 64,
                "scales": [1.0, 2.0, 4.0],
                "neighbor_search_method": "radius"
            },
            "transformer": {
                "patch_size": 4,
                "hidden_size": 256,
                "num_layers": 6,
                "positional_embedding": "rope"
            }
        }
    },

    "dataset": {
        "name": "eagle_tri_aggregated",
        "metaname": "eagle/triangle",
        "base_path": "/var/llm/sci-data/",
        "use_metadata_stats": false,
        "use_sparse": false,
        "train_size": 280,
        "val_size": 60,
        "test_size": 60,
        "max_time_diff": 14,
        "time_step": 2,
        "coord_scaling": "global_scaling",
        "batch_size": 8,
        "num_workers": 8,
        "shuffle": true,
        "rand_dataset": true,
        "metric": "final_step",
        "predict_mode": "autoregressive",
        "stepper_mode": "output",
        "use_time_norm": true
    },

    "optimizer": {
        "name": "adamw",
        "args": {
            "lr": 1e-4,
            "weight_decay": 1e-5,
            "epoch": 500,
            "loss_scale": 1.0,
            "eval_every_eps": 5,
            "scheduler": "mix",
            "max_lr": 5e-4,
            "min_lr": 1e-5,
            "final_lr": 1e-5
        }
    },

    "path": {
        "ckpt_path": ".ckpt/eagle/eagle_tri.pt",
        "loss_path": ".loss/eagle/eagle_tri.png",
        "result_path": ".results/eagle/eagle_tri.png",
        "database_path": ".database/eagle/eagle_tri.csv"
    }
}
